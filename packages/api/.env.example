# filepath: packages/api/.env.example

# Environment
NODE_ENV=development
PORT=5000

# Database (Postgres connection string used by Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/mens_store_cms"

# JWT
# Must be at least 32 characters long. Generate one with:
#   openssl rand -base64 48
JWT_SECRET="replace-this-with-a-strong-random-secret-of-at-least-32-chars"

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Temporary: shared secret required by POST /api/auth/bootstrap-admin to
# create the very first ADMIN account. The route self-disables once any
# ADMIN user exists in the database, so this can be removed afterwards.
# Must be at least 16 characters long.
ADMIN_BOOTSTRAP_KEY="replace-with-a-long-random-string"
