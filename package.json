{
  "name": "mens-store-cms",
  "version": "1.0.0",
  "description": "Avantaria women's clothing store CMS",
  "main": "index.js",
  "packageManager": "npm@11.18.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run db:generate"
  },
  "keywords": [
    "cms",
    "ecommerce",
    "mens-store",
    "womens-clothing",
    "avantaria"
  ],
  "author": "Firas Abbas",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3",
    "turbo": "^2.11.3"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.27.7": true,
    "@prisma/engines@5.22.0": true
  }
}
